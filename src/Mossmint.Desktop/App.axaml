<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mossmint.Desktop.ViewModels"
             xmlns:views="using:Mossmint.Desktop.Views"
             xmlns:c="using:Mossmint.Desktop.Controls"
             x:Class="Mossmint.Desktop.App"
             Name="Mossmint"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Mossmint.Desktop/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Mossmint.Desktop/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#96CCA7" RegionColor="#111A17" />
        <ColorPaletteResources x:Key="Light" Accent="#346B4F" RegionColor="#F7F6F0" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Mossmint.Desktop/Themes/Controls.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <!-- Overview and the end of setup show the same cards. -->
    <DataTemplate DataType="vm:MetricCard">
      <Border Classes="card" Margin="0,0,12,0" Padding="16,14" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.ControlTypeOverride="Group" AutomationProperties.IsControlElementOverride="True">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,8,0" />
            <c:StatusBadge Grid.Column="1" Tone="{Binding Tone}" Text="{Binding Status}" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Classes="card-title" Text="{Binding Headline}" TextWrapping="Wrap" />
          <TextBlock Classes="mono" FontSize="28" Foreground="{DynamicResource AccentText}" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
          <ItemsControl ItemsSource="{Binding Facts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="mono faint" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:WelcomeViewModel">
      <views:WelcomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel">
      <views:ShellView />
    </DataTemplate>
    <DataTemplate DataType="vm:CreateProfileViewModel">
      <views:CreateProfileView />
    </DataTemplate>
    <DataTemplate DataType="vm:RecoveryKeyViewModel">
      <views:RecoveryKeyView />
    </DataTemplate>
    <DataTemplate DataType="vm:UnlockViewModel">
      <views:UnlockView />
    </DataTemplate>
    <DataTemplate DataType="vm:RestoreViewModel">
      <views:RestoreView />
    </DataTemplate>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="vm:ImportPreviewViewModel">
      <views:ImportPreviewView />
    </DataTemplate>
    <!-- Where one source account's rows go; shared by CSV and statement files. -->
    <DataTemplate DataType="vm:DestinationRow">
      <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
        <StackPanel Spacing="4" Width="340" Margin="0,0,12,6">
          <TextBlock Classes="field-label" Text="{Binding Label, StringFormat='Rows from {0}'}" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" PlaceholderText="Choose an account" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding Label, StringFormat='Account for {0}'}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:DestinationOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4" Width="220" Margin="0,0,12,6" IsVisible="{Binding IsNew}">
          <TextBlock Classes="field-label" Text="New account name" />
          <TextBox Text="{Binding NewName}" AutomationProperties.Name="{Binding Label, StringFormat='New account name for {0}'}" />
        </StackPanel>
        <StackPanel Spacing="4" Width="160" Margin="0,0,12,6" IsVisible="{Binding IsNew}">
          <TextBlock Classes="field-label" Text="Type" />
          <ComboBox ItemsSource="{x:Static vm:DestinationRow.Kinds}" SelectedItem="{Binding NewKind}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding Label, StringFormat='New account type for {0}'}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:KindOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </WrapPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:ConnectionsPageViewModel">
      <views:ConnectionsPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:ImportsPageViewModel">
      <views:ImportsPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:OverviewPageViewModel">
      <views:OverviewPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:CashFlowPageViewModel">
      <views:CashFlowPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:PaychecksPageViewModel">
      <views:PaychecksPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:BillsPageViewModel">
      <views:BillsPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:DebtsPageViewModel">
      <views:DebtsPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:ScenariosPageViewModel">
      <views:ScenariosPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:SavingsPageViewModel">
      <views:SavingsPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:TransactionsPageViewModel">
      <views:TransactionsPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:BackupsPageViewModel">
      <views:BackupsPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsPageViewModel">
      <views:SettingsPageView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
