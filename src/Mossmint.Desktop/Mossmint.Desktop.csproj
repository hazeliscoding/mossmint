<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/mossmint.ico</ApplicationIcon>
    <AssemblyTitle>Mossmint</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/**/*.txt;Assets/**/LICENSE" />
    <None Include="Assets/**/*.txt;Assets/**/LICENSE" CopyToOutputDirectory="PreserveNewest" LinkBase="licenses" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mossmint.Application/Mossmint.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mossmint.Desktop.SmokeTests" />
    <InternalsVisibleTo Include="Mossmint.Screenshots" />
  </ItemGroup>
</Project>
