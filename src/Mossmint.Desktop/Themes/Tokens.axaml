<!-- Mossmint colour tokens (docs/design/design-system.md). Views use these keys
     through DynamicResource; never put colour literals in a view. Dark is the
     first theme; light is a re-tuning, not an inversion. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgCanvas" Color="#111A17" />
      <SolidColorBrush x:Key="BgPanel" Color="#16221E" />
      <SolidColorBrush x:Key="BgSurface" Color="#1B2823" />
      <SolidColorBrush x:Key="BgElevated" Color="#25372F" />
      <SolidColorBrush x:Key="BgSelected" Color="#2E4239" />
      <SolidColorBrush x:Key="BgInset" Color="#0C1411" />

      <SolidColorBrush x:Key="BorderHairline" Color="#243229" />
      <SolidColorBrush x:Key="BorderDefault" Color="#304439" />
      <SolidColorBrush x:Key="BorderStrong" Color="#43594C" />

      <SolidColorBrush x:Key="TextPrimary" Color="#F3F5F0" />
      <SolidColorBrush x:Key="TextSecondary" Color="#B4C1B9" />
      <SolidColorBrush x:Key="TextFaint" Color="#7E8F85" />
      <SolidColorBrush x:Key="TextDisabled" Color="#51625A" />
      <SolidColorBrush x:Key="TextInverse" Color="#111A17" />

      <SolidColorBrush x:Key="Accent" Color="#96CCA7" />
      <SolidColorBrush x:Key="AccentHover" Color="#B2DCBE" />
      <SolidColorBrush x:Key="AccentActive" Color="#7DBB92" />
      <SolidColorBrush x:Key="AccentText" Color="#B6E2C4" />
      <SolidColorBrush x:Key="AccentSubtle" Color="#1F96CCA7" />
      <SolidColorBrush x:Key="AccentBorder" Color="#6696CCA7" />

      <SolidColorBrush x:Key="SignalHealthy" Color="#8ED39F" />
      <SolidColorBrush x:Key="SignalHealthyText" Color="#B6E2C4" />
      <SolidColorBrush x:Key="SignalHealthySubtle" Color="#1F8ED39F" />
      <SolidColorBrush x:Key="SignalHealthyBorder" Color="#618ED39F" />

      <SolidColorBrush x:Key="SignalWarning" Color="#E6C879" />
      <SolidColorBrush x:Key="SignalWarningText" Color="#F0D898" />
      <SolidColorBrush x:Key="SignalWarningSubtle" Color="#21E6C879" />
      <SolidColorBrush x:Key="SignalWarningBorder" Color="#6BE6C879" />

      <SolidColorBrush x:Key="SignalCritical" Color="#F29E9B" />
      <SolidColorBrush x:Key="SignalCriticalText" Color="#F7B8B5" />
      <SolidColorBrush x:Key="SignalCriticalSubtle" Color="#21F29E9B" />
      <SolidColorBrush x:Key="SignalCriticalBorder" Color="#73F29E9B" />

      <!-- Lavender: estimated, scheduled and projected values. -->
      <SolidColorBrush x:Key="SignalInfo" Color="#BBA8E4" />
      <SolidColorBrush x:Key="SignalInfoText" Color="#D2C6EE" />
      <SolidColorBrush x:Key="SignalInfoSubtle" Color="#21BBA8E4" />
      <SolidColorBrush x:Key="SignalInfoBorder" Color="#6BBBA8E4" />

      <SolidColorBrush x:Key="SignalNeutral" Color="#7E8F85" />
      <SolidColorBrush x:Key="SignalNeutralText" Color="#B4C1B9" />
      <SolidColorBrush x:Key="SignalNeutralSubtle" Color="#247E8F85" />
      <SolidColorBrush x:Key="SignalNeutralBorder" Color="#737E8F85" />

      <SolidColorBrush x:Key="Loss" Color="#D9AE6A" />
      <SolidColorBrush x:Key="LossText" Color="#EBC98F" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgCanvas" Color="#F7F6F0" />
      <SolidColorBrush x:Key="BgPanel" Color="#F2F1EA" />
      <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BgElevated" Color="#EDF2EC" />
      <SolidColorBrush x:Key="BgSelected" Color="#E2EAE3" />
      <SolidColorBrush x:Key="BgInset" Color="#F1F3EE" />

      <SolidColorBrush x:Key="BorderHairline" Color="#E3E6DF" />
      <SolidColorBrush x:Key="BorderDefault" Color="#D1D7CF" />
      <SolidColorBrush x:Key="BorderStrong" Color="#B2BDB4" />

      <SolidColorBrush x:Key="TextPrimary" Color="#202B25" />
      <SolidColorBrush x:Key="TextSecondary" Color="#536159" />
      <SolidColorBrush x:Key="TextFaint" Color="#7A877F" />
      <SolidColorBrush x:Key="TextDisabled" Color="#AEB8B1" />
      <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Accent" Color="#346B4F" />
      <SolidColorBrush x:Key="AccentHover" Color="#2A5940" />
      <SolidColorBrush x:Key="AccentActive" Color="#1F4732" />
      <SolidColorBrush x:Key="AccentText" Color="#2E5F46" />
      <SolidColorBrush x:Key="AccentSubtle" Color="#1A346B4F" />
      <SolidColorBrush x:Key="AccentBorder" Color="#59346B4F" />

      <SolidColorBrush x:Key="SignalHealthy" Color="#2F7D55" />
      <SolidColorBrush x:Key="SignalHealthyText" Color="#24643F" />
      <SolidColorBrush x:Key="SignalHealthySubtle" Color="#1A2F7D55" />
      <SolidColorBrush x:Key="SignalHealthyBorder" Color="#592F7D55" />

      <SolidColorBrush x:Key="SignalWarning" Color="#8C6200" />
      <SolidColorBrush x:Key="SignalWarningText" Color="#6F4D00" />
      <SolidColorBrush x:Key="SignalWarningSubtle" Color="#1F8C6200" />
      <SolidColorBrush x:Key="SignalWarningBorder" Color="#668C6200" />

      <SolidColorBrush x:Key="SignalCritical" Color="#B43E39" />
      <SolidColorBrush x:Key="SignalCriticalText" Color="#96302B" />
      <SolidColorBrush x:Key="SignalCriticalSubtle" Color="#1AB43E39" />
      <SolidColorBrush x:Key="SignalCriticalBorder" Color="#66B43E39" />

      <SolidColorBrush x:Key="SignalInfo" Color="#7867A8" />
      <SolidColorBrush x:Key="SignalInfoText" Color="#5E4D8F" />
      <SolidColorBrush x:Key="SignalInfoSubtle" Color="#1F7867A8" />
      <SolidColorBrush x:Key="SignalInfoBorder" Color="#667867A8" />

      <SolidColorBrush x:Key="SignalNeutral" Color="#7A877F" />
      <SolidColorBrush x:Key="SignalNeutralText" Color="#536159" />
      <SolidColorBrush x:Key="SignalNeutralSubtle" Color="#247A877F" />
      <SolidColorBrush x:Key="SignalNeutralBorder" Color="#737A877F" />

      <SolidColorBrush x:Key="Loss" Color="#A8722A" />
      <SolidColorBrush x:Key="LossText" Color="#8A5C1E" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="FontSans">avares://Mossmint.Desktop/Assets/Fonts#Manrope</FontFamily>
  <FontFamily x:Key="FontMono">avares://Mossmint.Desktop/Assets/Fonts#IBM Plex Mono</FontFamily>

  <x:Double x:Key="SidebarWidth">216</x:Double>
  <x:Double x:Key="SidebarCollapsedWidth">48</x:Double>
  <x:Double x:Key="TopBarHeight">44</x:Double>
  <x:Double x:Key="TitleBarHeight">32</x:Double>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusCard">6</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
</ResourceDictionary>
