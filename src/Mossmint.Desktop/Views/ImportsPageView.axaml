<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mossmint.Desktop.ViewModels"
             xmlns:c="using:Mossmint.Desktop.Controls"
             x:Class="Mossmint.Desktop.Views.ImportsPageView"
             x:DataType="vm:ImportsPageViewModel">

  <StackPanel Spacing="20" MaxWidth="980" HorizontalAlignment="Left">
    <StackPanel Spacing="4">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock Classes="secondary" Text="{Binding Purpose}" TextWrapping="Wrap" />
    </StackPanel>

    <c:StatusBadge Tone="{Binding StatusTone}" Text="{Binding Status}" HorizontalAlignment="Left" AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Step 1: pick workbooks or a bank file. -->
    <Border Classes="card" Padding="24,20" IsVisible="{Binding IsChoosing}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="Import workbooks" />
        <TextBlock Classes="prose secondary"
                   Text="Choose your budget workbook and any debt workbooks together. Mossmint reads a copy, shows you everything it would change, and saves nothing until you say so. Each value keeps its sheet and cell." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Choose workbooks…" Command="{Binding ChooseWorkbooksCommand}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Reading the workbooks" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="24,20" IsVisible="{Binding IsChoosing}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="Import a file from your bank" />
        <TextBlock Classes="prose secondary"
                   Text="A CSV or OFX/QFX statement your bank lets you download, or an export from YNAB, Monarch, Actual, Mint or Mossmint. You choose where it goes once and Mossmint remembers it for the next file from the same place. Nothing is saved until you've seen the dry run." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Choose a file…" Command="{Binding ChooseBankFileCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Step 1b: match a bank file's columns. -->
    <Border c:FormFocus.IsForm="True" Classes="card" Padding="24,20" IsVisible="{Binding IsMatching}">
      <StackPanel Spacing="14" DataContext="{Binding BankFile}" x:DataType="vm:BankFileViewModel">
        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="Match the columns" />
          <TextBlock Text="{Binding File.Name, FallbackValue=''}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="prose secondary" Text="{Binding Summary, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Classes="notice" Text="{Binding EncodingWarning}" TextWrapping="Wrap" IsVisible="{Binding EncodingWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <WrapPanel Orientation="Horizontal">
          <StackPanel Spacing="4" Width="260" Margin="0,0,12,10">
            <TextBlock Classes="field-label" Text="Date" />
            <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding DateColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="Date column">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ColumnOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="4" Width="300" Margin="0,0,12,10">
            <TextBlock Classes="field-label" Text="Date format" />
            <ComboBox ItemsSource="{Binding DateFormats}" SelectedItem="{Binding DateFormat}" HorizontalAlignment="Stretch" AutomationProperties.Name="Date format"
                      PlaceholderText="No format fits this column">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:DateFormatOption"><TextBlock Classes="mono" Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="4" Width="260" Margin="0,0,12,10">
            <TextBlock Classes="field-label" Text="Description" />
            <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding DescriptionColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="Description column">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ColumnOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDateAmbiguous}">
          <c:StatusBadge Tone="Warning" Text="Check the date order" VerticalAlignment="Top" />
          <TextBlock Classes="compact" TextWrapping="Wrap" MaxWidth="560"
                     Text="Every date here could be month first or day first. Check that the example reads the way your bank meant it." />
        </StackPanel>

        <WrapPanel Orientation="Horizontal">
          <StackPanel Spacing="4" Width="320" Margin="0,0,12,10">
            <TextBlock Classes="field-label" Text="Amounts" />
            <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style}" HorizontalAlignment="Stretch" AutomationProperties.Name="How amounts are written">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AmountStyleOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="4" Width="260" Margin="0,0,12,10" IsVisible="{Binding UsesOneAmount}">
            <TextBlock Classes="field-label" Text="Amount" />
            <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding AmountColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="Amount column">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ColumnOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="4" Width="260" Margin="0,0,12,10" IsVisible="{Binding UsesDirection}">
            <TextBlock Classes="field-label" Text="Debit or credit" />
            <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding DirectionColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="Debit or credit column">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ColumnOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="4" Width="260" Margin="0,0,12,10" IsVisible="{Binding UsesSeparateColumns}">
            <TextBlock Classes="field-label" Text="Money out" />
            <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding MoneyOutColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="Money out column">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ColumnOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="4" Width="260" Margin="0,0,12,10" IsVisible="{Binding UsesSeparateColumns}">
            <TextBlock Classes="field-label" Text="Money in" />
            <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding MoneyInColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="Money in column">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ColumnOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </WrapPanel>

        <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
          <TextBlock Classes="field-label" Text="Account column (files with several accounts)" />
          <ComboBox ItemsSource="{Binding OptionalColumns}" SelectedItem="{Binding AccountColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="Account column">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ColumnOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <Border Classes="separator" />
        <TextBlock Classes="card-title" Text="Where the rows go" />
        <ItemsControl ItemsSource="{Binding Destinations}" />

        <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Preview the import" Command="{Binding $parent[UserControl].((vm:ImportsPageViewModel)DataContext).PreviewBankFileCommand}" />
          <Button Classes="ghost" Content="Cancel" IsCancel="True" Command="{Binding $parent[UserControl].((vm:ImportsPageViewModel)DataContext).CancelBankFileCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Step 1c: choose the accounts a statement file goes to. -->
    <Border c:FormFocus.IsForm="True" Classes="card" Padding="24,20" IsVisible="{Binding IsPlacing}">
      <StackPanel Spacing="14" DataContext="{Binding StatementFile}" x:DataType="vm:StatementFileViewModel">
        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="Choose the accounts" />
          <TextBlock Text="{Binding File.Name, FallbackValue=''}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="prose secondary" Text="{Binding Summary, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Classes="prose secondary" TextWrapping="Wrap"
                     Text="Each transaction is matched by the bank's own ID, so a statement that overlaps an earlier one adds only what's new. The balance it reports counts as confirmed." />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Destinations}" />
        <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Preview the import" Command="{Binding $parent[UserControl].((vm:ImportsPageViewModel)DataContext).PreviewStatementFileCommand}" />
          <Button Classes="ghost" Content="Cancel" IsCancel="True" Command="{Binding $parent[UserControl].((vm:ImportsPageViewModel)DataContext).CancelBankFileCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Step 2: the dry run. -->
    <Border Classes="card" Padding="24,20" IsVisible="{Binding HasPreview}">
      <StackPanel Spacing="16">
        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="Dry run" />
          <TextBlock Classes="prose secondary" Text="{Binding Preview.Verdict, FallbackValue=''}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Import" Command="{Binding ImportCommand}" />
          <Button Content="Save report…" Command="{Binding SaveReportCommand}" />
          <Button Classes="ghost" Content="Cancel" IsCancel="True" Command="{Binding CancelPreviewCommand}" />
          <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Importing" IsVisible="{Binding IsBusy}" Width="120" VerticalAlignment="Center" />
        </StackPanel>
        <ContentControl Content="{Binding Preview}" />
      </StackPanel>
    </Border>

    <!-- The review queue. -->
    <Border Classes="card" Padding="24,20">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="To review" />
            <TextBlock Classes="prose secondary" Text="{Binding ReviewSummary}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowClosed}" OnContent="Showing settled" OffContent="Open only" VerticalAlignment="Top" AutomationProperties.Name="Show settled items" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Review}" IsVisible="{Binding HasReview}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReviewItemRow">
              <Border Classes="separator-top" Padding="0,12,0,4">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="compact secondary" Text="{Binding Detail}" TextWrapping="Wrap" />
                    <TextBlock Classes="mono compact faint" Text="{Binding Sources}" TextWrapping="Wrap" IsVisible="{Binding HasSources}" />
                  </StackPanel>
                  <c:StatusBadge Grid.Column="1" Tone="{Binding Tone}" Text="{Binding Badge}" VerticalAlignment="Top" Margin="16,0,0,0" />
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Mark resolved" IsVisible="{Binding IsOpen}" AutomationProperties.Name="{Binding Title, StringFormat='Mark {0} resolved'}"
                            Command="{Binding $parent[UserControl].((vm:ImportsPageViewModel)DataContext).ResolveCommand}" CommandParameter="{Binding}" />
                    <Button Classes="ghost" Content="Dismiss" IsVisible="{Binding IsOpen}" AutomationProperties.Name="{Binding Title, StringFormat='Dismiss {0}'}"
                            Command="{Binding $parent[UserControl].((vm:ImportsPageViewModel)DataContext).DismissCommand}" CommandParameter="{Binding}" />
                    <Button Classes="ghost" Content="Reopen" IsVisible="{Binding !IsOpen}" AutomationProperties.Name="{Binding Title, StringFormat='Reopen {0}'}"
                            Command="{Binding $parent[UserControl].((vm:ImportsPageViewModel)DataContext).ReopenCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="24,20" IsVisible="{Binding HasHistory}">
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="Import history" />
        <ItemsControl ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryRow">
              <Grid ColumnDefinitions="170,*" Margin="0,3">
                <TextBlock Classes="mono compact" Text="{Binding When}" />
                <TextBlock Grid.Column="1" Classes="compact secondary" Text="{Binding Summary}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
