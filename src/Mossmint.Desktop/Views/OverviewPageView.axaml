<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mossmint.Desktop.ViewModels"
             xmlns:c="using:Mossmint.Desktop.Controls"
             x:Class="Mossmint.Desktop.Views.OverviewPageView"
             x:DataType="vm:OverviewPageViewModel">

  <UserControl.Styles>
    <Style Selector="UniformGrid.metrics">
      <Setter Property="Columns" Value="4" />
    </Style>
    <ContainerQuery Name="page" Query="max-width:840">
      <Style Selector="UniformGrid.metrics">
        <Setter Property="Columns" Value="2" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <StackPanel Spacing="16" MaxWidth="1240" HorizontalAlignment="Left" Container.Name="page" Container.Sizing="Width">
    <StackPanel Spacing="4">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock Classes="secondary" Text="{Binding Purpose}" TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="card" Padding="24,20" IsVisible="{Binding Unavailable, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="10">
        <c:StatusBadge Tone="Warning" Text="No forecast yet" HorizontalAlignment="Left" />
        <TextBlock Classes="prose" Text="{Binding Unavailable}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Metrics}" IsVisible="{Binding HasForecast}" Margin="0,0,-12,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Classes="metrics" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MetricCard">
          <Border Classes="card" Margin="0,0,12,0" Padding="16,14" AutomationProperties.Name="{Binding AccessibleName}">
            <StackPanel Spacing="6">
              <DockPanel>
                <c:StatusBadge DockPanel.Dock="Right" Tone="{Binding Tone}" Text="{Binding Status}" VerticalAlignment="Top" />
                <TextBlock Classes="label" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,8,0" />
              </DockPanel>
              <TextBlock Classes="card-title" Text="{Binding Headline}" TextWrapping="Wrap" />
              <TextBlock Classes="mono" FontSize="28" Foreground="{DynamicResource AccentText}" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
              <ItemsControl ItemsSource="{Binding Facts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="mono faint" Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="card" Padding="16,14" IsVisible="{Binding HasForecast}">
      <StackPanel Spacing="8">
        <TextBlock Classes="card-title" Text="{Binding ChartTitle}" />
        <TextBlock Classes="compact secondary" Text="Line: closing balance, dipping to each day's low · dashed: the cushion · PAY: paydays" TextWrapping="Wrap" />
        <c:ForecastChart Forecast="{Binding Forecast}" Height="250" AutomationProperties.Name="{Binding ChartDescription}" />
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="24,20">
      <StackPanel Spacing="12">
        <c:StatusBadge Tone="Healthy" Text="Encrypted on this PC" HorizontalAlignment="Left" />
        <TextBlock Classes="section" Text="Your profile" />
        <TextBlock Classes="prose secondary" Text="{Binding Summary}" TextWrapping="Wrap" />
        <Button Content="Add more with Start fresh" Command="{Binding RunSetupCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="24,20">
      <StackPanel Spacing="10">
        <TextBlock Classes="card-title" Text="Accounts" />
        <ItemsControl ItemsSource="{Binding Accounts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecordRow">
              <Grid ColumnDefinitions="*,Auto,140" Margin="0,6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Classes="compact faint" Text="{Binding Detail}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="mono" FontSize="14" Text="{Binding Amount}" VerticalAlignment="Center" Margin="16,0" />
                <c:StatusBadge Grid.Column="2" Tone="{Binding Tone}" Text="{Binding Status}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
