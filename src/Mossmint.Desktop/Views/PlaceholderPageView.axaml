<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mossmint.Desktop.ViewModels"
             xmlns:c="using:Mossmint.Desktop.Controls"
             x:Class="Mossmint.Desktop.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">

  <StackPanel Spacing="20">
    <StackPanel Spacing="4">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock Classes="secondary" Text="{Binding Purpose}" TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="card" Padding="28,24" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Spacing="12">
        <c:StatusBadge Tone="Info" Text="{Binding MilestoneLabel}" HorizontalAlignment="Left" />
        <TextBlock Classes="section" Text="{Binding EmptyTitle}" />
        <TextBlock Classes="prose secondary" Text="{Binding EmptyBody}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
