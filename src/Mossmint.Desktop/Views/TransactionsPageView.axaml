<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mossmint.Desktop.ViewModels"
             xmlns:c="using:Mossmint.Desktop.Controls"
             xmlns:accounts="using:Mossmint.Domain.Accounts"
             x:Class="Mossmint.Desktop.Views.TransactionsPageView"
             x:DataType="vm:TransactionsPageViewModel">

  <!-- Sizing="Width" takes the full width, so the table fills the page and scrolls only when it must. -->
  <StackPanel Spacing="16" MaxWidth="1240" HorizontalAlignment="Left" Container.Sizing="Width">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"
                  IsVisible="{Binding Account, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Button Content="Reconcile balance" Command="{Binding StartReconcileCommand}" />
        <Button Classes="primary" Content="Add entry" Command="{Binding StartAddCommand}" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="page-title" Text="{Binding Title}" />
        <TextBlock Classes="secondary" Text="{Binding Purpose}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <Border Classes="card" Padding="24,20" IsVisible="{Binding Account, Converter={x:Static ObjectConverters.IsNull}}">
      <TextBlock Classes="prose secondary" Text="No cash accounts yet. Add a checking account with the Start fresh setup on the Overview page." TextWrapping="Wrap" />
    </Border>

    <DockPanel IsVisible="{Binding Account, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Account}" MinWidth="200" Margin="0,0,12,0" AutomationProperties.Name="Account">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="accounts:Account">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Classes="mono compact secondary" Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <TextBlock Classes="notice" Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Border c:FormFocus.IsForm="True" Classes="card" Padding="20,16" IsVisible="{Binding IsAdding}">
      <StackPanel Spacing="10">
        <TextBlock Classes="card-title" Text="Add an entry" />
        <TextBlock Classes="compact secondary" TextWrapping="Wrap"
                   Text="Money that already went in or out. It changes today's cash until you confirm a newer balance; money still to come belongs in Bills." />
        <WrapPanel Orientation="Horizontal">
          <StackPanel Spacing="4" Width="240" Margin="0,0,12,8">
            <TextBlock Classes="field-label" Text="Description" />
            <TextBox Text="{Binding EntryDescription}" AutomationProperties.Name="Description" />
          </StackPanel>
          <StackPanel Spacing="4" Width="150" Margin="0,0,12,8">
            <TextBlock Classes="field-label" Text="Amount" />
            <TextBox Classes="money" Text="{Binding EntryAmount}" PlaceholderText="0.00" AutomationProperties.Name="Amount" />
          </StackPanel>
          <StackPanel Spacing="4" Margin="0,0,12,8">
            <TextBlock Classes="field-label" Text="Direction" />
            <ToggleSwitch IsChecked="{Binding IsMoneyIn}" OnContent="Money in" OffContent="Money out" AutomationProperties.Name="Money in" />
          </StackPanel>
          <StackPanel Spacing="4" Width="180" Margin="0,0,12,8">
            <TextBlock Classes="field-label" Text="Date" />
            <CalendarDatePicker SelectedDate="{Binding EntryDate}" HorizontalAlignment="Stretch" AutomationProperties.Name="Date" />
          </StackPanel>
          <StackPanel Spacing="4" Width="180" Margin="0,0,12,8">
            <TextBlock Classes="field-label" Text="Category (optional)" />
            <TextBox Text="{Binding EntryCategory}" AutomationProperties.Name="Category" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Classes="error" Text="{Binding FormError}" TextWrapping="Wrap" IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Record" Command="{Binding SaveEntryCommand}" />
          <Button Classes="ghost" Content="Cancel" Command="{Binding CancelFormsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border c:FormFocus.IsForm="True" Classes="card" Padding="20,16" IsVisible="{Binding IsReconciling}">
      <StackPanel Spacing="10">
        <TextBlock Classes="card-title" Text="Reconcile the balance" />
        <TextBlock Classes="compact secondary" Text="{Binding ExpectedText}" TextWrapping="Wrap" />
        <StackPanel Spacing="4" Width="200" HorizontalAlignment="Left">
          <TextBlock Classes="field-label" Text="Balance your bank shows" />
          <TextBox Classes="money" Text="{Binding BankBalance}" PlaceholderText="0.00" AutomationProperties.Name="Balance your bank shows" />
        </StackPanel>
        <TextBlock Classes="error" Text="{Binding FormError}" TextWrapping="Wrap" IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Confirm balance" Command="{Binding SaveReconcileCommand}" />
          <Button Classes="ghost" Content="Cancel" Command="{Binding CancelFormsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="16,14,16,4" IsVisible="{Binding Account, Converter={x:Static ObjectConverters.IsNotNull}}">
      <!-- Too narrow for every column? The table scrolls sideways instead of hiding them (WCAG 1.4.10).
           It's measured at its natural width, so the description is capped to keep it from widening the table. -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,10">
        <StackPanel Spacing="4" Grid.IsSharedSizeScope="True">
          <TextBlock Classes="prose secondary" Text="Nothing recorded for this account yet." IsVisible="{Binding IsEmpty}" />
          <Grid Margin="0,0,0,4" IsVisible="{Binding !IsEmpty}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition SharedSizeGroup="date" Width="Auto" MinWidth="110" />
              <ColumnDefinition Width="*" MinWidth="220" />
              <ColumnDefinition SharedSizeGroup="source" Width="Auto" MinWidth="100" />
              <ColumnDefinition SharedSizeGroup="amount" Width="Auto" MinWidth="120" />
              <ColumnDefinition SharedSizeGroup="status" Width="Auto" MinWidth="130" />
              <ColumnDefinition SharedSizeGroup="action" Width="Auto" MinWidth="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="label" Text="DATE" />
            <TextBlock Grid.Column="1" Classes="label" Text="DESCRIPTION" />
            <TextBlock Grid.Column="2" Classes="label" Text="SOURCE" />
            <TextBlock Grid.Column="3" Classes="label" Text="AMOUNT" TextAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LedgerRow">
                <Border Classes="separator-top" Padding="0,7">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="date" Width="Auto" MinWidth="110" />
                      <ColumnDefinition Width="*" MinWidth="220" />
                      <ColumnDefinition SharedSizeGroup="source" Width="Auto" MinWidth="100" />
                      <ColumnDefinition SharedSizeGroup="amount" Width="Auto" MinWidth="120" />
                      <ColumnDefinition SharedSizeGroup="status" Width="Auto" MinWidth="130" />
                      <ColumnDefinition SharedSizeGroup="action" Width="Auto" MinWidth="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="mono" Text="{Binding Date}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="360" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                      <TextBlock Classes="compact faint" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="compact secondary" Text="{Binding Source}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Amount}" TextAlignment="Right" VerticalAlignment="Center" />
                    <c:StatusBadge Grid.Column="4" Tone="{Binding Tone}" Text="{Binding Status}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Button Grid.Column="5" Classes="ghost" Content="Void" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                            IsVisible="{Binding CanVoid}" AutomationProperties.Name="{Binding VoidName}"
                            Command="{Binding $parent[UserControl].((vm:TransactionsPageViewModel)DataContext).VoidCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </StackPanel>
</UserControl>
